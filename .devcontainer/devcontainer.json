{
  "name": "Prophesee OpenEB C++ Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "cmake.configureOnOpen": true
      }
    }
  },
  // Mount X11 socket and pass DISPLAY for GUI windows
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  // Grant hardware/USB access if using physical Prophesee EVKs
  "runArgs": [
    "--net=host",
    "--privileged",
    "-v", "/dev/bus/usb:/dev/bus/usb"
  ],
  "remoteUser": "root"
}
